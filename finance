<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الشؤون المالية - نظام الموارد البشرية</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1 class="logo">نظام الموارد البشرية</h1>
            </div>
            <ul class="nav-links">
                <li><a href="index.html" class="nav-link">الرئيسية</a></li>
                <li><a href="reports.html" class="nav-link">تقارير الموظفين</a></li>
                <li><a href="finance.html" class="nav-link active">الشؤون المالية</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container">
            <!-- Header Section -->
            <header class="header-section">
                <div class="header-content">
                    <h2 class="header-title">الشؤون المالية</h2>
                    <p class="header-subtitle">إدارة الرواتب والمستحقات والعمليات المالية</p>
                </div>
                <svg class="header-illustration" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">
                    <!-- رسم توضيحي للمالية -->
                    <rect x="60" y="50" width="180" height="100" fill="#f39c12" opacity="0.1" rx="10"/>
                    <circle cx="150" cy="100" r="30" fill="none" stroke="#f39c12" stroke-width="3"/>
                    <path d="M 150 75 L 150 125 M 125 100 L 175 100" stroke="#f39c12" stroke-width="2"/>
                    <rect x="50" y="160" width="200" height="5" fill="#f39c12" opacity="0.3"/>
                </svg>
            </header>

            <!-- Stats Section -->
            <section class="stats-section">
                <div class="stat-card finance-stat">
                    <div class="stat-value">50+</div>
                    <div class="stat-label">موظف مدفوع الراتب</div>
                </div>
                <div class="stat-card finance-stat">
                    <div class="stat-value">100%</div>
                    <div class="stat-label">الميزانية المخطط</div>
                </div>
                <div class="stat-card finance-stat">
                    <div class="stat-value">12</div>
                    <div class="stat-label">دورة مالية سنوية</div>
                </div>
                <div class="stat-card finance-stat">
                    <div class="stat-value">6</div>
                    <div class="stat-label">عمليات مالية</div>
                </div>
            </section>

            <!-- Finance Section -->
            <section class="finance-section">
                <!-- Finance Card 1 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="30" cy="30" r="20" fill="none" stroke="#f39c12" stroke-width="2"/>
                            <path d="M 30 15 L 30 45 M 15 30 L 45 30" stroke="#f39c12" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">إدارة الرواتب</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">حساب ودفع رواتب الموظفين</p>
                </div>

                <!-- Finance Card 2 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 10 20 L 50 20 L 45 40 L 15 40 Z" fill="none" stroke="#f39c12" stroke-width="2"/>
                            <line x1="20" y1="20" x2="20" y2="40" stroke="#f39c12" stroke-width="1.5"/>
                            <line x1="30" y1="20" x2="30" y2="40" stroke="#f39c12" stroke-width="1.5"/>
                            <line x1="40" y1="20" x2="40" y2="40" stroke="#f39c12" stroke-width="1.5"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">المستحقات والبدلات</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">إدارة المستحقات والبدلات الإضافية</p>
                </div>

                <!-- Finance Card 3 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <rect x="15" y="15" width="30" height="30" fill="none" stroke="#f39c12" stroke-width="2" rx="3"/>
                            <circle cx="30" cy="30" r="5" fill="#f39c12" opacity="0.5"/>
                            <path d="M 25 25 L 35 35" stroke="#f39c12" stroke-width="2" fill="none"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">الخصومات والتأمينات</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">تحديد الخصومات والعمليات التأمينية</p>
                </div>

                <!-- Finance Card 4 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <rect x="12" y="18" width="36" height="24" fill="none" stroke="#f39c12" stroke-width="2" rx="2"/>
                            <line x1="18" y1="30" x2="42" y2="30" stroke="#f39c12" stroke-width="1.5"/>
                            <circle cx="20" cy="24" r="2" fill="#f39c12"/>
                            <circle cx="40" cy="24" r="2" fill="#f39c12"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">التقارير المالية</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">عرض وتحليل التقارير المالية الشاملة</p>
                </div>

                <!-- Finance Card 5 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <rect x="20" y="10" width="20" height="40" fill="none" stroke="#f39c12" stroke-width="2" rx="2"/>
                            <rect x="26" y="20" width="8" height="30" fill="#f39c12" opacity="0.6"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">سجل الرواتب</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">سجل شامل لجميع الرواتب المدفوعة</p>
                </div>

                <!-- Finance Card 6 -->
                <div class="finance-card">
                    <div class="finance-icon">
                        <svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 15 45 L 20 30 L 30 40 L 40 20 L 45 35" fill="none" stroke="#f39c12" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="20" cy="30" r="2" fill="#f39c12"/>
                            <circle cx="30" cy="40" r="2" fill="#f39c12"/>
                            <circle cx="40" cy="20" r="2" fill="#f39c12"/>
                        </svg>
                    </div>
                    <h3 class="finance-title">تخطيط الميزانية</h3>
                    <p class="finance-date">آخر تحديث: قريباً</p>
                    <p class="finance-placeholder">تخطيط وتوقع الميزانية المالية</p>
                </div>
            </section>

            <!-- Empty State -->
            <section class="empty-state">
                <svg class="empty-state-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="25" fill="none" stroke="#f39c12" stroke-width="2"/>
                    <path d="M 50 30 L 50 70 M 35 50 L 65 50" stroke="#f39c12" stroke-width="2"/>
                </svg>
                <p class="empty-state-text">سيتم إضافة المزيد من البيانات المالية قريباً</p>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 نظام الموارد البشرية. جميع الحقوق محفوظة.</p>
        </div>
    </footer>
</body>
</html>
